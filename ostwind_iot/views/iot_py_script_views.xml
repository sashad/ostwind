<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="iot_py_script_list" model="ir.ui.view">
        <field name="name">iot.py.script.list</field>
        <field name="model">py.script</field>
        <field name="arch" type="xml">
            <list delete="0">
                <field name="name" />
                <field name="key" />
                <field name="user_id" />
                <field name="py_script_group_id" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="iot_py_script_form" model="ir.ui.view">
        <field name="name">iot.py.script.form</field>
        <field name="model">py.script</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="run_script"
                            string="Run Test"
                            type="object"
                            class="btn-primary"
                            context="{'test': True}"
                        />
                    </div>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="key" />
                            <field name="py_script_group_id" eval="[(4, ref('group_restricted_py_script_manager'))]"/>
                            <field name="active" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Code">
                            <field name="code" widget="ace" options="{'mode': 'python'}"/>
                        </page>
                        <page string="Default Context">
                            <field name="default_context" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record model="ir.actions.act_window" id="iot_user_py_script_action">
        <field name="name">Python Scripts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">py.script</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'apply_script_filter': True}</field>
        <field name="groups_id" eval="[(4, ref('group_restricted_py_script_manager'))]"/>
    </record>
</odoo>
