<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_py_script_result_form" model="ir.ui.view">
        <field name="name">py.script.result.form</field>
        <field name="model">py.script.result</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="message" nolabel="1" widget="html" readonly="1" style="width: 100%;"/>
                </sheet>
                <footer>
                    <button name="action_discard" string="Close" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
